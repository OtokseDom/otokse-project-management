# Server env for /var/www/project/.env — NOT committed (no .env.example at root is
# tracked as .env.example; copy to .env on the server and fill strong passwords).
# Laravel app env lives separately in backend/.env (see backend/.env.example).
MYSQL_DATABASE=project_db
MYSQL_USER=project_user
MYSQL_PASSWORD=CHANGE_ME__strong_password_here
MYSQL_ROOT_PASSWORD=CHANGE_ME__strong_root_password_here
