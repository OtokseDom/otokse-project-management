# Otokse Project Management — production compose.
# Deploy path on VPS: /var/www/project/docker-compose.yml
#
# Topology: NO host ports published. TLS + routing live in the existing
# ecommerce-nginx-1 container, which joins project_network (see the ecommerce
# compose snippet in nginx/project.otokse.com.conf header) and:
#   /api/* -> fastcgi project_backend:9000
#   /*     -> static SPA from project_frontend_dist volume
# MySQL is internal-only. Secrets come from .env (root) + backend/.env (Laravel).

services:
  mysql:
    image: mysql:8.0
    container_name: project_mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${MYSQL_DATABASE:-project_db}
      MYSQL_USER: ${MYSQL_USER:-project_user}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?set MYSQL_PASSWORD in .env}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?set MYSQL_ROOT_PASSWORD in .env}
    volumes:
      - project_mysql_data:/var/lib/mysql
    networks:
      - project_network
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p$$MYSQL_ROOT_PASSWORD"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    image: project-backend
    container_name: project_backend
    restart: unless-stopped
    env_file:
      - ./backend/.env
    volumes:
      # Task/discussion attachments survive rebuilds.
      - project_storage:/var/www/html/storage/app/public
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - project_network
    healthcheck:
      # NOTE: :9000 is FastCGI, not HTTP — curl cannot probe it
      # (curl -f http://localhost:9000/up would always fail). Process + config
      # check instead; end-to-end proof is the VPS smoke test via nginx /api.
      test: ["CMD-SHELL", "php-fpm -t 2>/dev/null && pidof php-fpm"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  # One-shot: copies the SPA build (built inside the image via
  # frontend/.env.production, same-origin /api) into the volume that the
  # ecommerce-nginx-1 container serves. Re-run on every frontend change:
  #   docker compose up --force-recreate frontend-build
  frontend-build:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      target: build
    image: project-frontend-build
    container_name: project_frontend_build
    command: sh -c "rm -rf /out/* && cp -r dist/. /out/ && echo '[frontend-build] dist copied:' && ls /out | head"
    volumes:
      - project_frontend_dist:/out
    networks:
      - project_network
    restart: "no"

volumes:
  # Explicit names so the ecommerce nginx service can mount them as external
  # volumes (compose would otherwise prefix them: project_project_*).
  project_mysql_data:
    name: project_mysql_data
  project_storage:
    name: project_storage
  project_frontend_dist:
    name: project_frontend_dist

networks:
  project_network:
    name: project_network
