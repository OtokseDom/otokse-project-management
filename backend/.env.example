APP_NAME="Otokse Project Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Manila"
APP_URL=https://project.otokse.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=project_mysql
DB_PORT=3306
DB_DATABASE=project_db
DB_USERNAME=project_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=project_

# Sanctum / CORS — subdomain allowlist (Bearer-token SPA, no cookies)
SANCTUM_STATEFUL_DOMAINS=project.otokse.com
CORS_ALLOWED_ORIGINS=https://project.otokse.com

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Server notes (do NOT commit backend/.env with real values) ---
# APP_KEY:        generate on first deploy — php artisan key:generate --force
# DB_PASSWORD:    must match MYSQL_PASSWORD in /var/www/project/.env
# Removed vs stock Laravel: AWS_*, REDIS_*, MEMCACHED_* (no third-party services,
# no Redis — session/cache/queue all use `database`). Re-add only via ADR.
